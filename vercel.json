{
  "functions": {
    "apps/web/src/app/api/style/route.ts": {
      "maxDuration": 30
    },
    "apps/web/src/app/api/v1/recommend/route.ts": {
      "maxDuration": 30
    },
    "apps/web/src/app/api/v1/recweather/route.ts": {
      "maxDuration": 30
    },
    "apps/web/src/app/api/followup/route.ts": {
      "maxDuration": 30
    },
    "apps/web/src/app/api/weather/route.ts": {
      "maxDuration": 15
    },
    "apps/web/src/app/api/geocode/route.ts": {
      "maxDuration": 10
    }
  },
  "crons": [
    {
      "path": "/api/cron/automatic-recommendations",
      "schedule": "* * * * *"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-DNS-Prefetch-Control", "value": "on" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "origin-when-cross-origin" }
      ]
    }
  ]
}
